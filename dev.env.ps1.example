$env:GOOGLE_CLIENT_ID="<google client id>"
$env:GOOGLE_CLIENT_SECRET="<google client secret>"

$env:JWT_SECRET="<jwt secret (32+ chars recommended)>"

# Mailtrap (SMTP Sandbox)
$env:MAIL_HOST="sandbox.smtp.mailtrap.io"
$env:MAIL_PORT="2525"
$env:MAIL_USERNAME="<mailtrap username>"
$env:MAIL_PASSWORD="<mailtrap password>"

# From address shown in emails
$env:MAIL_FROM="no-reply@omnicare.local"

# Backend base URL used in verification links
$env:VERIFY_BASE_URL="http://localhost:8080"
